{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sherpa.local/schemas/codebase-model.schema.json",
  "title": "codebase-model",
  "description": "Output of `sherpa scan`. Layer T0 (git), T1 (modules, conventions) and generators are always present; T2 (language adapters) arrives in a later schema version.",
  "type": "object",
  "required": [
    "sherpa",
    "schema_version",
    "repo",
    "origin",
    "git",
    "modules",
    "generators",
    "conventions",
    "coupling"
  ],
  "additionalProperties": false,
  "properties": {
    "sherpa": {
      "type": "string",
      "description": "Sherpa version that produced the model."
    },
    "schema_version": {
      "type": "integer",
      "const": 5
    },
    "repo": {
      "type": "string",
      "description": "Basename of the repo directory."
    },
    "origin": {
      "type": "string",
      "description": "URL of the remote origin."
    },
    "git": {
      "type": "object",
      "description": "Layer T0: everything from git, measured against origin/<trunk> (ADR-0003).",
      "required": [
        "trunk",
        "windows",
        "commits_total",
        "commits_90d",
        "commits_30d",
        "authors_90d",
        "first_commit",
        "last_commit",
        "files",
        "dirs",
        "hotspots"
      ],
      "additionalProperties": false,
      "properties": {
        "trunk": {
          "type": "object",
          "required": [
            "ref",
            "source",
            "rev"
          ],
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "description": "e.g. origin/main"
            },
            "source": {
              "type": "string",
              "enum": [
                "override",
                "origin/HEAD",
                "candidate"
              ],
              "description": "How the trunk was determined (ADR-0003)."
            },
            "rev": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "windows": {
          "type": "object",
          "required": [
            "as_of",
            "since_90d",
            "since_30d"
          ],
          "additionalProperties": false,
          "description": "Time windows. as_of = committer date of trunk.rev (default) or --as-of; this makes the scan reproducible for the same rev.",
          "properties": {
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "since_90d": {
              "type": "string",
              "format": "date-time"
            },
            "since_30d": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "commits_total": {
          "type": "integer",
          "minimum": 0,
          "description": "All commits on the trunk, merges included."
        },
        "commits_90d": {
          "type": "integer",
          "minimum": 0,
          "description": "Non-merge commits with since_90d < committer date <= as_of."
        },
        "commits_30d": {
          "type": "integer",
          "minimum": 0
        },
        "authors_90d": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct author names in the 90d window."
        },
        "first_commit": {
          "type": "string",
          "format": "date-time",
          "description": "Committer date of the root commit."
        },
        "last_commit": {
          "type": "string",
          "format": "date-time",
          "description": "Committer date of trunk.rev."
        },
        "files": {
          "type": "array",
          "description": "Every file in the tree of trunk.rev (git ls-tree), sorted by path.",
          "items": {
            "type": "object",
            "required": [
              "path",
              "loc",
              "generated",
              "commits_90d",
              "commits_30d",
              "authors_90d",
              "last_change"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "loc": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "Lines; null = binary (NUL byte in the blob)."
              },
              "generated": {
                "type": "boolean",
                "description": "Path matches a generated glob (defaults in sherpa.config.GENERATED_DEFAULT, extended via sherpa.toml [scan].generated). Stays in files/dirs, is never a hotspot."
              },
              "commits_90d": {
                "type": "integer",
                "minimum": 0
              },
              "commits_30d": {
                "type": "integer",
                "minimum": 0
              },
              "authors_90d": {
                "type": "integer",
                "minimum": 0
              },
              "last_change": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Committer date of the latest commit in the 90d window; null if none."
              }
            }
          }
        },
        "dirs": {
          "type": "array",
          "description": "Aggregates per directory of depth 1 and 2 (\"\" = root), sorted by path. commits_* counts commits touching at least one file below it.",
          "items": {
            "type": "object",
            "required": [
              "path",
              "files",
              "loc",
              "generated_files",
              "commits_90d",
              "commits_30d",
              "authors_90d"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "files": {
                "type": "integer",
                "minimum": 0
              },
              "loc": {
                "type": "integer",
                "minimum": 0,
                "description": "Sum of text LOC below it."
              },
              "generated_files": {
                "type": "integer",
                "minimum": 0,
                "description": "Generator outputs below it (families in sherpa.scan.generators, sherpa.toml globs included); lockfiles and noise do not count."
              },
              "commits_90d": {
                "type": "integer",
                "minimum": 0
              },
              "commits_30d": {
                "type": "integer",
                "minimum": 0
              },
              "authors_90d": {
                "type": "integer",
                "minimum": 0,
                "description": "Distinct authors of the commits in the 90d window touching a file below it."
              }
            }
          }
        },
        "hotspots": {
          "type": "array",
          "description": "Top N text files by score = commits_90d * loc, descending, ties by path. Only files with commits_90d >= 1 and generated = false.",
          "items": {
            "type": "object",
            "required": [
              "path",
              "commits_90d",
              "loc",
              "score"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "commits_90d": {
                "type": "integer",
                "minimum": 1
              },
              "loc": {
                "type": "integer",
                "minimum": 0
              },
              "score": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "description": "Layer T1: one module per manifest (csproj/fsproj/vbproj, pyproject.toml, setup.py, package.json, go.mod, Cargo.toml with [package], pom.xml, build.gradle). Sorted by path, id. Manifests under node_modules/, vendor/, target/, bin/, obj/, dist/, build/ do not count.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "kind",
          "manifest",
          "is_test",
          "files",
          "loc",
          "test_files",
          "generated_files",
          "deps",
          "dependents",
          "tested_by",
          "commits_90d",
          "commits_30d",
          "authors_90d",
          "hotspots",
          "sub_dirs",
          "coupling"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Module name from the manifest (csproj stem, project.name, package name, go module, crate name, artifactId)."
          },
          "path": {
            "type": "string",
            "description": "Directory of the manifest; \"\" = repo root. Files belong to the deepest module whose directory contains them."
          },
          "kind": {
            "type": "string",
            "enum": [
              "dotnet",
              "python",
              "node",
              "go",
              "rust",
              "java"
            ]
          },
          "manifest": {
            "type": "string"
          },
          "is_test": {
            "type": "boolean",
            "description": "A test module (dotnet: IsTestProject, test framework package or name *Tests/*Test; every language: a test directory in the module path)."
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "loc": {
            "type": "integer",
            "minimum": 0,
            "description": "Sum of text LOC of the assigned files."
          },
          "test_files": {
            "type": "integer",
            "minimum": 0,
            "description": "Assigned files under tests/, test/, __tests__/, spec/ or with a test name pattern (test_*.py, *_test.go, *.test.ts, *Test.java, *Tests.cs, …)."
          },
          "generated_files": {
            "type": "integer",
            "minimum": 0,
            "description": "Generator outputs in the module. Share of files >= plan.generated_share → no agent/librarian, a skill for the generator instead (ADR-0011)."
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Dependencies on other modules of THIS repo (ProjectReference, path deps, name matches for python/node/go/java). External packages are deliberately absent."
          },
          "dependents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Inverse of deps."
          },
          "tested_by": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Test modules (is_test) that have this module in deps."
          },
          "commits_90d": {
            "type": "integer",
            "minimum": 0,
            "description": "Non-merge commits in the 90d window touching at least one file of the module; once per commit."
          },
          "commits_30d": {
            "type": "integer",
            "minimum": 0
          },
          "authors_90d": {
            "type": "integer",
            "minimum": 0
          },
          "hotspots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 3 paths in the module by commits_90d×loc, not generated, descending."
          },
          "sub_dirs": {
            "type": "array",
            "description": "Directories inside the module, depths 1-4 below its path, sorted by path: the raw material for sub-units of a single-manifest repository (ADR-0020). source_files counts files in the module's own language(s); package = Python package (__init__.py). Test directories are included and marked by name in the plan.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "depth",
                "files",
                "source_files",
                "package",
                "loc",
                "commits_90d",
                "commits_30d",
                "authors_90d"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "depth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "files": {
                  "type": "integer",
                  "minimum": 0
                },
                "source_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "package": {
                  "type": "boolean"
                },
                "loc": {
                  "type": "integer",
                  "minimum": 0
                },
                "commits_90d": {
                  "type": "integer",
                  "minimum": 0
                },
                "commits_30d": {
                  "type": "integer",
                  "minimum": 0
                },
                "authors_90d": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "coupling": {
            "type": "array",
            "description": "Temporal coupling (Tornhill, ADR-0021): up to 3 partner modules that changed in the same commits, descending by shared, ties by module. Only partners with shared >= coupling.min_shared and share >= coupling.min_share; commits touching more than coupling.cap modules are excluded.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "module",
                "shared",
                "share",
                "of"
              ],
              "properties": {
                "module": {
                  "type": "string"
                },
                "shared": {
                  "type": "integer",
                  "minimum": 1
                },
                "share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "shared / of, rounded to 2 decimals"
                },
                "of": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "This module's measured commits: below coupling.cap, the excluded root left out — the denominator of share, and what the owner doc prints (ADR-0039). Less than or equal to commits_90d."
                }
              }
            }
          }
        }
      }
    },
    "generators": {
      "type": "array",
      "description": "Detected generators: one entry per (family, owning module), sorted by family, module. Families and detection patterns: sherpa.scan.generators.FAMILIES; principle ADR-0011.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "title",
          "module",
          "home",
          "generated_files",
          "generated_loc",
          "sources",
          "configs",
          "command",
          "skill"
        ],
        "properties": {
          "family": {
            "type": "string",
            "description": "Family id (ef-migrations, protobuf, …) or \"custom\" for sherpa.toml [scan].generated."
          },
          "title": {
            "type": "string"
          },
          "module": {
            "type": [
              "string",
              "null"
            ],
            "description": "Module id owning the generated files; null = no module responsible."
          },
          "home": {
            "type": "string",
            "description": "Common directory of the outputs (without outputs: of the config); \"\" = root. The central place for a skill."
          },
          "generated_files": {
            "type": "integer",
            "minimum": 0
          },
          "generated_loc": {
            "type": "integer",
            "minimum": 0
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 5 source paths of the family (closest to home first)."
          },
          "configs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 5 configuration files of the tool."
          },
          "command": {
            "type": "string",
            "description": "Regeneration command or hint."
          },
          "skill": {
            "type": "boolean",
            "description": "false = tool-managed (lockfiles), no skill proposal."
          }
        }
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "ci",
        "containers"
      ],
      "description": "Conventions detected from the file tree.",
      "properties": {
        "languages": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Language (by file suffix) → sum of LOC, sorted descending."
        },
        "ci": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CI definitions (.github/workflows/*, .gitlab-ci.yml, azure-pipelines*.yml, YAML under a pipelines/, .pipelines/, .azure-pipelines/ or .azuredevops/ directory, Jenkinsfile, .circleci/config.yml, …)."
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dockerfile*, docker-compose*.yml, compose*.yml."
        }
      }
    },
    "coupling": {
      "type": "object",
      "additionalProperties": false,
      "description": "How coupling was measured: cap = max(5, ceil(modules / 2)) modules per commit; skipped_commits = commits above the cap (squash merges, mass renames), measured_commits = the rest; excluded = the root module left out as a catch-all when other modules exist (ADR-0026), else null.",
      "required": [
        "cap",
        "skipped_commits",
        "measured_commits",
        "min_shared",
        "min_share"
      ],
      "properties": {
        "cap": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_commits": {
          "type": "integer",
          "minimum": 0
        },
        "measured_commits": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": ["string", "null"]
        },
        "min_shared": {
          "type": "integer",
          "minimum": 0
        },
        "min_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
