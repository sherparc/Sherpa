#!/bin/sh
# Refuses pushes to main. Enable with: git config core.hooksPath .githooks
# Background: GitHub rulesets are not enforced on private repos in the Free plan (ADR-0009);
# every step goes branch -> PR -> squash merge. The only deliberate escape hatch: git push --no-verify.
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "pre-push: direct push to ${remote_ref#refs/heads/} is blocked — create a branch and open a PR." >&2
            exit 1
            ;;
    esac
done
exit 0
